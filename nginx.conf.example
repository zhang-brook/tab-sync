# Nginx 反向代理配置示例
# 使用方式：将此文件放在 tab-sync-server 目录下，取消 docker-compose.yml 中 nginx 服务的注释
# SSL 证书推荐使用 Let's Encrypt + certbot 自动获取

server {
    listen 80;
    server_name your-domain.com;

    # Let's Encrypt 验证
    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    # HTTP → HTTPS 重定向（获取证书后启用）
    # return 301 https://$host$request_uri;
}

